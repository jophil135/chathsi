NODE_ENV=production
# Render supplies PORT automatically. This no-disk configuration uses temporary storage.
DATABASE_PATH=/tmp/chathsi.db
UPLOAD_DIR=/tmp/chathsi-uploads
VOICE_DIR=/tmp/chathsi-voice
MAX_IMAGE_MB=12
MAX_MEDIA_MB=50
MAX_VOICE_MB=12
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=true
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=chathsi_admin
ADMIN_PASSWORD=replace-with-a-unique-strong-admin-password
# Payment requests remain admin-reviewed. Configure a real provider and signed server webhooks before accepting money.
PAYMENTS_ENABLED=false

# WebRTC: STUN is provided by default. Add TURN credentials for reliable calls across restrictive networks.
STUN_URL=stun:stun.relay.metered.ca:80
# Metered TURN: keep the username and credential private in Render Environment.
# TURN_URLS accepts a comma-separated list or a JSON array.
# TURN_URLS=turn:your-turn-host:3478,turn:your-turn-host:3478?transport=tcp
# TURN_USERNAME=your-new-turn-username
# TURN_CREDENTIAL=your-new-turn-credential
# Legacy single TURN_URL is still supported when TURN_URLS is not set.

# Persistent public media storage (stories, post media, avatars, group media, adverts)
# Create a Cloudinary account and set these in Render Environment.
# Prefer CLOUDINARY_URL from the Cloudinary dashboard, or set all three values below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_MEDIA_FOLDER=chathis

# Music upload limit (MB)
MAX_SONG_MB=30
