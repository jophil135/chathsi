{
  "name": "chathsi-social-platform",
  "version": "1.3.0",
  "private": true,
  "description": "CHATHIS social network using Node.js, CockroachDB/PostgreSQL-compatible storage and Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node --check src/server.js && node --check src/sqlite-store.js && node --check src/cockroach-store.js && node --check src/models.js && node --check public/app.js",
    "db:check": "node scripts/check-db.js",
    "db:import": "node scripts/import-snapshot.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "pg": "^8.13.1",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
